{
  "name": "@convax/deploy-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Cloudflare deployment adapter for the Convax API",
  "scripts": {
    "build": "pnpm typecheck && pnpm dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "node --import tsx/esm ../../libs/dsh/scripts/run-oxlint.ts --config ../../.oxlintrc.json src",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --local --port 8104",
    "dry-run": "wrangler deploy --dry-run --strict --outdir dist",
    "deploy": "wrangler deploy --env production --strict",
    "dry-run:production": "wrangler deploy --env production --dry-run --strict --outdir dist"
  },
  "dependencies": {
    "@convax/api": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
