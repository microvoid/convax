{
  "name": "@convax/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-demos.mjs && astro dev --port 4321",
    "build": "node scripts/prepare-demos.mjs && astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "check": "nimbus-docs check",
    "test": "node --test tests/locale.test.mjs tests/worker.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "deploy": "pnpm run build && node scripts/prepare-cloudflare.mjs && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.19.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.3.3",
    "clsx": "^2.1.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "playwright": "1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "wrangler": "4.148.0"
  },
  "description": "Bilingual Convax documentation, built with Nimbus and Astro.",
  "engines": {
    "node": ">=24.9.0"
  }
}
