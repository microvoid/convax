{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#dsh:build": {
      "cache": false
    },
    "//#dsh:build:artifacts": {
      "cache": false
    },
    "//#dsh:build:check": {
      "cache": false
    },
    "//#dsh:typecheck": {
      "cache": false
    },
    "//#dsh:lint": {
      "cache": false
    },
    "//#convax:test": {
      "cache": false
    },
    "@convax/docs#build": {
      "outputs": [
        "dist/**"
      ],
      "env": [
        "DOCS_SITE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/assets/convax-demos/**"
      ]
    },
    "@convax/docs#typecheck": {
      "cache": false,
      "dependsOn": [
        "@convax/docs#build"
      ]
    },
    "@convax/docs#lint:docs": {
      "cache": false,
      "dependsOn": [
        "@convax/docs#build"
      ]
    },
    "@convax/docs#check": {
      "cache": false,
      "dependsOn": [
        "@convax/docs#build"
      ]
    },
    "@convax/docs#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DOCS_SITE_URL"
      ]
    },
    "@convax/docs#preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@convax/docs#build"
      ],
      "env": [
        "DOCS_SITE_URL"
      ]
    }
  },
  "globalPassThroughEnv": [
    "DSH_*",
    "DEEPSEEK_*",
    "ELECTRON_*",
    "NODE_*"
  ]
}
