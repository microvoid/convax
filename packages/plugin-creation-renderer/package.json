{
  "name": "@deepseek-ai/dsh-convax-plugin-creation-renderer",
  "version": "0.2.1-rc.3",
  "description": "Creation workbench card and Provider settings for Convax",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": {
    "platform": "web",
    "inject": ["@deepseek-ai/dsh-convax-plugin-renderer", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-renderer"],
    "external": ["@deepseek-ai/dsh-api-gateway/client", "@deepseek-ai/dsh-convax-plugin-renderer/client"]
  } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "locale"],
  "license": "MIT",
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-convax-plugin-host": "workspace:*",
    "@deepseek-ai/dsh-convax-plugin-renderer": "workspace:*",
    "@deepseek-ai/dsh-convax-plugin-creation-host": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-util-crypto": "workspace:*",
    "lucide-react": "1.64.0",
    "react": "^18.2.0"
  },
  "publishConfig": { "access": "public" }
}
