      "note": "手势开始时捕获目标 thread"
    },
    {
      "id": "edge-confirmed",
      "from": "host",
      "to": "gesture",
      "y": 224,
      "label": "连线已提交",
      "variant": "return"
    },
    {
      "id": "prepare-reference",
      "from": "gesture",
      "to": "host",
      "y": 262,
      "label": "prepareReference",
      "note": "准备失败不回滚已保存连线"
    },
    {
      "id": "resource-ready",
      "from": "host",
      "to": "gesture",
      "y": 324,
      "label": "文件或文件夹引用",
      "variant": "return",
      "note": "检查提供方、版本、文件系统与源稳定性"
    },
    {
      "id": "create-first-thread",
      "from": "gesture",
      "to": "host",
      "y": 392,
      "label": "无目标时创建 thread",
      "note": "仅在没有捕获到目标时调用"
    },
    {
      "id": "thread-ready",
      "from": "host",
