    },
    {
      "id": "native-send",
      "from": "draft",
      "to": "session",
      "y": 624,
      "label": "用户原生发送",
      "variant": "emphasis",
      "note": "仅保留引用进消息并记录 Session"
    },
    {
      "id": "cut-edge",
      "from": "gesture",
      "to": "host",
      "y": 690,
      "label": "可选：remove-connections",
      "note": "只改图关系；现有草稿不变"
    }
