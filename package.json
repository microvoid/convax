{
  "name": "@convax/workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "packages/*",
    "libs/dsh/vendor/*",
    "libs/dsh/packages/*/*",
    "libs/dsh/native/system",
    "libs/dsh/native/system/packages/*",
    "libs/dsh/apps/*",
    "libs/dsh/benchmarks",
    "libs/dsh/website",
    "libs/dsh/python/sdk-runtime"
  ],
  "scripts": {
    "build": "turbo run dsh:build",
    "build:artifacts": "turbo run dsh:build:artifacts",
    "build:check": "turbo run dsh:build:check",
    "typecheck": "turbo run dsh:typecheck",
    "lint": "turbo run dsh:lint",
    "test": "turbo run convax:test",
    "test:web:built": "node --env-file-if-exists=.env scripts/dsh.mjs test:web:built",
    "test:e2e": "node --env-file-if-exists=.env scripts/dsh.mjs test:e2e",
    "doc-sync": "node --env-file-if-exists=.env scripts/dsh.mjs doc-sync",
    "dsh": "node --env-file-if-exists=.env --import tsx/esm libs/dsh/apps/cli/src/bin.ts",
    "start:desktop": "pnpm --filter @deepseek-ai/dsh-convax-plugin-renderer run desktop",
    "dev:desktop": "pnpm --filter @deepseek-ai/dsh-convax-plugin-renderer run desktop:dev",
    "start:web": "node --env-file-if-exists=.env scripts/dsh.mjs start:web",
    "dev:web": "node --env-file-if-exists=.env scripts/dsh.mjs dev:web",
    "dsh:build": "node --env-file-if-exists=.env scripts/dsh.mjs build",
    "dsh:build:artifacts": "node --env-file-if-exists=.env scripts/dsh.mjs build:artifacts",
    "dsh:build:check": "node --env-file-if-exists=.env scripts/dsh.mjs build:check",
    "dsh:typecheck": "node --env-file-if-exists=.env scripts/dsh.mjs typecheck",
    "dsh:lint": "node --env-file-if-exists=.env scripts/dsh.mjs lint && node --import tsx/esm libs/dsh/scripts/run-oxlint.ts --config .oxlintrc.json packages scripts tests",
    "convax:test": "node --env-file-if-exists=.env scripts/dsh.mjs exec vitest run packages/plugin-host/tests packages/plugin-renderer/tests tests/convax-ci-workflow.spec.ts tests/workspace-resolution.client.spec.ts",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "postinstall": "node libs/dsh/scripts/install-lefthook.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-convax-plugin-host": "workspace:*",
    "@deepseek-ai/dsh-convax-plugin-renderer": "workspace:*",
    "@deepseek-ai/dsh-hooks-claude-code": "workspace:*",
    "@deepseek-ai/dsh-hooks-codex": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-ptc": "workspace:*",
    "@deepseek-ai/dsh-tool-ralph": "workspace:*",
    "@deepseek-ai/dsh-tool-terminal": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-stagehand-native": "workspace:*",
    "@deepseek-ai/dsh-computer-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "workspace:*",
    "@deepseek-ai/dsh-cua": "workspace:*",
    "@deepseek-ai/dsh-experimental-claude-code-mods": "workspace:*",
    "@deepseek-ai/dsh-llm-replay": "workspace:*",
    "@deepseek-ai/dsh-subagent-dsh-sdk": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@yao-pkg/pkg": "6.21.0",
    "@yarnpkg/cli-dist": "4.18.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "execa": "^10.0.1",
    "zod": "^4.4.3",
    "extract-zip": "^2.0.1",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.2",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.3.2",
    "jscpd": "^5.1.2",
    "jsdom": "29.1.1",
    "lefthook": "^2.1.12",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "papaparse": "5.5.3",
    "pnpm": "11.28.5",
    "publint": "^0.3.24",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "spdx-expression-parse": "^5.0.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-skill-office": "workspace:*",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/dsh-tool-working-directory": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*",
    "@deepseek-ai/dsh-experimental-worktree": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-worktree": "workspace:*",
    "@deepseek-ai/dsh-cua-bundle": "workspace:*",
    "@deepseek-ai/dsh-experimental-subagent-oar": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-subagent-oar": "workspace:*",
    "@deepseek-ai/dsh-experimental-cua-macos": "workspace:*",
    "@deepseek-ai/dsh-action-cards": "workspace:*",
    "turbo": "2.11.10"
  },
  "type": "module"
}
